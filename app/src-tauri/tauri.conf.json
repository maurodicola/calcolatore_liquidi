{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier Liquidi",
  "version": "1.0.0",
  "identifier": "io.github.maurodicola.atelierliquidi",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atelier Liquidi",
        "width": 1400,
        "height": 900,
        "minWidth": 380,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mauro Di Cola",
    "copyright": "© 2026 Mauro Di Cola · Licenza MIT",
    "shortDescription": "Calcolatore personale per liquidi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["Italian"],
        "installMode": "currentUser"
      }
    }
  }
}
